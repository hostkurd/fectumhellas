{
  "name": "hostkurd/fectumhellas",
  "description": "FECTUM Hellas real estate website, built on FloCMS",
  "type": "project",
  "license": "proprietary",

  "autoload": {
    "psr-4": {
      "FloCMS\\Controllers\\": "controllers/",
      "FloCMS\\Models\\": "models/",
      "FloCMS\\Support\\": "support/",
      "App\\Api\\": "api/",
      "App\\Commands\\": "commands/",
      "App\\Admin\\Blocks\\": "admin/Blocks/",
            "App\\Components\\": "components/"
    }
  },

  "authors": [
    {
      "name": "HostKurd"
    }
  ],

  "minimum-stability": "stable",
  "prefer-stable": true,

  "require": {
    "php": "^8.1",
    "hostkurd/flocms-core": "^2.9.0",
    "hostkurd/flocms-cli": "^2.0.1",
    "hostkurd/flocms-uploader": "^1.2.1",
    "hostkurd/flocms-captcha": "^1.1.0",
    "hostkurd/flocms-admin": "^0.42.0",
    "hostkurd/flocms-reactive": "^0.5.1"
  },

  "scripts": {
    "post-create-project-cmd": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php -r \"is_dir('storage') || mkdir('storage', 0755);\"",
      "@php -r \"is_dir('storage/logs') || mkdir('storage/logs', 0755, true);\"",
      "@php flo key:generate",
      "Composer\\Config::disableProcessTimeout",
      "@php flo setup"
    ],
    "test": "phpunit"
  },

  "suggest": {
    "hostkurd/flocms-admin": "The admin panel: dashboard, users management, profile and your own content resources (php flo setup, or php flo admin:install)",
    "hostkurd/flocms-api": "A JSON API under /api/v1: routes, tokens, rate limits, OpenAPI (php flo setup, or php flo api:install)",
    "hostkurd/flocms-reactive": "Optional PHP reactive components for interactive pages without full-page reloads"
  },

  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },

  "autoload-dev": {
    "psr-4": {
      "HostKurd\\Flocms\\Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.1.0"
    }
  }
}
