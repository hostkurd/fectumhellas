APP_NAME="FECTUM Hellas"
APP_VERSION=2.0.2
APP_ENV=local
APP_KEY=
APP_URL=http://localhost

# Template
APP_TEMPLATE=default

# General Settings
SITE_NAME="FECTUM Hellas"
SITE_NAME_ADMIN="FECTUM Hellas"
PRIMARY_EMAIL=info@fectumhellas.gr

# Multilingual Settings
LANGUAGES=en,ar,el
DEFAULT_LANG=en

# Database Configuration
# Leave DB_NAME empty until you have created a database (e.g. in phpMyAdmin).
# XAMPP default: DB_USERNAME=root with an empty DB_PASSWORD.
# SQLite (Core 2.9+): DB_TYPE=sqlite and DB_NAME=a file, relative to the project
# (e.g. storage/database.sqlite); run `php flo migrate` to create it.
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# Dev Mode
APP_DEBUG=true
# Reverse proxies (IPs/CIDR, comma separated) whose X-Forwarded-For is trusted
TRUSTED_PROXIES=

# API (public/api.php, when added: php flo setup or php flo api:install)
# CORS origins, comma separated; one-label wildcards allowed (https://*.example.com)
API_CORS_ORIGINS=
# Requests per minute per client
API_RATE_LIMIT=60
# IPs/CIDR ranges that can use the API while the site is in maintenance mode
API_MAINTENANCE_ALLOWED_IPS=
# Legacy /api/<controller>/<action> route (no CSRF, no auth). Leave false for new sites.
LEGACY_API=false
